{
  "name": "Acme",
  "dataColors": [
    "#48B040",
    "#DAC6AB",
    "#89705D",
    "#53463C",
    "#C8C7CB",
    "#C7E4D5",
    "#A79486",
    "#7E746D"
  ],
  "maximum": "#48B040",
  "center": "#DAC6AB",
  "minimum": "#89705D",
  "good": "#48B040",
  "neutral": "#C8C7CB",
  "bad": "#DAC6AB",
  "background": "#E3F1EA",
  "firstLevelElements": "#171F1C",
  "secondaryBackground": "#F8F8F8",
  "tableAccent": "#48B040",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "color": "#171F1C"
    },
    "title": {
      "fontSize": 14,
      "color": "#171F1C"
    },
    "header": {
      "fontSize": 12,
      "color": "#171F1C"
    },
    "label": {
      "fontSize": 10,
      "color": "#53463C"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#E3F1EA"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#E3F1EA"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "*": [
          {
            "wordWrap": true
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#171F1C"
              }
            },
            "fontSize": 14,
            "alignment": "left",
            "titleWrap": false
          }
        ],
        "subtitle": [
          {
            "fontColor": {
              "solid": {
                "color": "#53463C"
              }
            },
            "fontSize": 11
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "showAxisTitle": true,
            "labelColor": {
              "solid": {
                "color": "#53463C"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#53463C"
              }
            },
            "gridlineStyle": "none"
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "showAxisTitle": true,
            "start": 0,
            "labelColor": {
              "solid": {
                "color": "#53463C"
              }
