            "titleColor": {
              "solid": {
                "color": "#53463C"
              }
            },
            "gridlineStyle": "none"
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#171F1C"
              }
            }
          }
        ],
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F8F8F8"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#C8C7CB"
              }
            },
            "radius": 0
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "dataPoint": [
          {
            "defaultColor": {
              "solid": {
                "color": "#48B040"
              }
            }
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "dataPoint": [
          {
            "defaultColor": {
              "solid": {
                "color": "#48B040"
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "dataPoint": [
          {
            "defaultColor": {
              "solid": {
                "color": "#48B040"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#171F1C"
              }
            }
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#171F1C"
              }
            }
          }
        ],
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F8F8F8"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#C8C7CB"
              }
            },
            "radius": 0
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#48B040"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "image": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "*": [
          {
            "$id": "default",
            "displayUnits": 1,
            "labelDisplayUnits": 1,
            "outline": false
          }
        ],
        "value": [
          {
            "fontSize": 26,
            "fontColor": {
              "solid": {
                "color": "#171F1C"
              }
            }
          }
        ],
        "label": [
          {
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#53463C"
              }
            }
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 12,
            "right": 12
          }
        ],
        "outline": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F8F8F8"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#C8C7CB"
              }
            },
            "radius": 0
          }
        ]
      }
    }
  }
}