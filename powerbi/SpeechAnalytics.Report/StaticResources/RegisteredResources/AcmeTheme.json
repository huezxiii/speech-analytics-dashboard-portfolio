{
  "name": "Acme",
  "dataColors": [
    "#0284C7",
    "#38BDF8",
    "#0EA5E9",
    "#818CF8",
    "#10B981",
    "#F59E0B",
    "#EF4444",
    "#94A3B8"
  ],
  "maximum": "#0284C7",
  "center": "#F59E0B",
  "minimum": "#EF4444",
  "good": "#10B981",
  "neutral": "#94A3B8",
  "bad": "#EF4444",
  "background": "#020617",
  "firstLevelElements": "#F8FAFC",
  "secondaryBackground": "#0F172A",
  "tableAccent": "#0284C7",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "color": "#F8FAFC"
    },
    "title": {
      "fontSize": 14,
      "color": "#F8FAFC"
    },
    "header": {
      "fontSize": 12,
      "color": "#F8FAFC"
    },
    "label": {
      "fontSize": 10,
      "color": "#94A3B8"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#020617"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#020617"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "*": [
          {
            "wordWrap": true
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "fontSize": 14,
            "alignment": "left",
            "titleWrap": false
          }
        ],
        "subtitle": [
          {
            "fontColor": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "fontSize": 11
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "showAxisTitle": true,
            "labelColor": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "gridlineStyle": "none"
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "showAxisTitle": true,
            "start": 0,
            "labelColor": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "gridlineStyle": "none"
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#F8FAFC"
              }
            }
          }
        ],
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "radius": 0
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "dataPoint": [
          {
            "defaultColor": {
              "solid": {
                "color": "#0284C7"
              }
            }
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "dataPoint": [
          {
            "defaultColor": {
              "solid": {
                "color": "#0284C7"
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "dataPoint": [
          {
            "defaultColor": {
              "solid": {
                "color": "#0284C7"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#F8FAFC"
              }
            }
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#F8FAFC"
              }
            }
          }
        ],
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "radius": 0
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "image": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "*": [
          {
            "$id": "default",
            "displayUnits": 1,
            "labelDisplayUnits": 1,
            "outline": false
          }
        ],
        "value": [
          {
            "fontSize": 26,
            "fontColor": {
              "solid": {
                "color": "#F8FAFC"
              }
            }
          }
        ],
        "label": [
          {
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#94A3B8"
              }
            }
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 12,
            "right": 12
          }
        ],
        "outline": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "radius": 0
          }
        ]
      }
    }
  }
}